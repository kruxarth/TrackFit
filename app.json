{
  "expo": {
    "name": "TrackFit",
    "slug": "trackfit",
    "version": "0.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b4a5e225-cc0b-4a71-821c-5c4a2f5afead",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/fitractlogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/fitractlogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1113"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.trackfit.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0E1113",
        "foregroundImage": "./assets/fitractlogo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/fitractlogo.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b4a5e225-cc0b-4a71-821c-5c4a2f5afead"
      }
    }
  }
}
